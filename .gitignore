# Grav — generated/runtime, safe to delete and regenerate
/cache/*
!/cache/.gitkeep
/logs/*
!/logs/.gitkeep
/tmp/*
!/tmp/.gitkeep
/backup/*
!/backup/.gitkeep

# Dependencies — committed rather than reinstalled. Grav core depends on
# getgrav/Twig, a fork pinned to a specific dev commit (not a published
# release), so "just run composer install on the server" isn't reliable —
# it has to be the exact same vendor/ this was tested against locally.
# /vendor/

# Credentials — admin password hash, API keys, etc. Never commit these.
/user/accounts/*
!/user/accounts/.gitkeep
!/user/accounts/.htaccess
/user/config/security-private.php
.env
.env.*.local
.env.local

# OS / editor cruft
.DS_Store
