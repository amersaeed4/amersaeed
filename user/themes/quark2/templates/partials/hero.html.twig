{% set id = id|default('hero') %}
{% set content = content|default(page.content) %}
{% set has_aurora = 'hero-aurora' in (page.header.hero_classes|default('')) %}
<section id="{{ id }}"
         class="section modular-hero hero {{ page.header.hero_classes }} {{ page.header.background.parallax ? 'parallax' : '' }}"
         {% if hero_image %}style="background-image: url('{{ hero_image.url }}');"{% endif %}>
    {% if hero_image %}<div class="image-overlay"></div>{% endif %}
    {% if has_aurora %}
    {# A handful of lighter, unfilled triangles scattered over the glow,
       each spinning slowly at its own speed for an organic feel. Purely
       decorative: aria-hidden, and they stop spinning under reduced-motion. #}
    <svg class="hero-network" viewBox="0 0 100 40" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
        <g transform="translate(15,10) scale(1.6)"><polygon points="0,-3 2.6,1.5 -2.6,1.5" class="hero-network__triangle hero-network__triangle--1" /></g>
        <g transform="translate(85,8) scale(1.3)"><polygon points="0,-3 2.6,1.5 -2.6,1.5" class="hero-network__triangle hero-network__triangle--2" /></g>
        <g transform="translate(50,30) scale(1.8)"><polygon points="0,-3 2.6,1.5 -2.6,1.5" class="hero-network__triangle hero-network__triangle--3" /></g>
        <g transform="translate(8,30) scale(1.1)"><polygon points="0,-3 2.6,1.5 -2.6,1.5" class="hero-network__triangle hero-network__triangle--4" /></g>
        <g transform="translate(92,30) scale(1.2)"><polygon points="0,-3 2.6,1.5 -2.6,1.5" class="hero-network__triangle hero-network__triangle--5" /></g>
    </svg>
    {% endif %}
    <div class="container" style="text-align: {{ page.header.hero_align|default('center') }}">
        {{ content|raw }}
    </div>
    <i id="to-start" class="pulse fa-solid fa-angle-down" aria-hidden="true"></i>
</section>
